        {
          "id": "C",
          "text": "Taloqda"
        },
        {
          "id": "D",
          "text": "Ayrisimon bezda"
        }
      ],
      "correct_answer": "B",
      "points": 10,
      "orderNum": 2,
      "explanation": "Eritropoez jarayoni asosan qizil suyak ko'migida sodir bo'ladi va eritropoetin gormoni orqali boshqariladi."
