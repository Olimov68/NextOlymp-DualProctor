{
  "name": "ibn-sino-olympiad",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "db:migrate": "node --import tsx scripts/database.mjs migrate",
    "db:admin": "node --import tsx scripts/database.mjs admin",
    "dev": "vite",
    "server": "tsx server/src/server.ts",
    "dev:all": "concurrently -k \"npm run server\" \"npm run dev\"",
    "typecheck:frontend": "tsc --noEmit",
    "typecheck": "npm run typecheck:frontend && npm run typecheck:server",
    "verify": "npm run typecheck && npm run lint && npm test && npm audit --package-lock-only --ignore-scripts",
    "typecheck:server": "tsc --project server/tsconfig.json --noEmit",
    "build": "npm run typecheck:frontend && npm run typecheck:server && vite build && node scripts/generate-routes.js",
    "lint": "eslint src server/src --ext .ts,.tsx --report-unused-disable-directives",
    "test": "node scripts/run-tests.mjs server/src/__tests__/http_integration.test.ts server/src/__tests__/anticheat_security.test.ts server/src/__tests__/postgres.integration.test.ts server/src/__tests__/hardening.integration.test.ts server/src/__tests__/socket.integration.test.ts server/src/__tests__/assessment.integration.test.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.28.9",
    "@types/qrcode": "^1.5.6",
    "axios": "^1.6.8",
    "bcryptjs": "^2.4.3",
    "canvas-confetti": "^1.9.2",
    "clsx": "^2.1.0",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "i18next": "^23.10.1",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.359.0",
    "mammoth": "^1.12.3",
    "nodemailer": "^10.1.0",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^14.1.0",
    "react-router-dom": "^7.18.4",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.4",
    "systeminformation": "^5.33.15",
    "tailwind-merge": "^2.2.2",
    "uuid": "^11.1.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zustand": "^4.5.2"
  },
  "overrides": {
    "source-map-js": "^1.2.2",
    "argparse": "^2.0.1",
    "uuid": "^11.1.1",
    "postcss-selector-parser": "^7.1.6",
    "chokidar": "^4.0.3",
    "micromatch": "^4.0.8"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/canvas-confetti": "^1.9.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.11.30",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@types/supertest": "^7.2.1",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.24.0",
    "@typescript-eslint/parser": "^8.24.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "postcss": "^8.4.38",
    "supertest": "^7.3.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.7.1",
    "typescript": "^5.2.2",
    "vite": "^8.3.1"
  }
}
