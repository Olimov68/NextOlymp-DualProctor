# NextOlymp Environment Configuration
PORT=5000
NODE_ENV=development

# Server Security: Required in production (minimum 32 characters)
JWT_SECRET=replace_with_strong_random_secret_at_least_32_characters_long

# CORS Allowed Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Initial Admin & Seed Credentials (set your own strong passwords)
INITIAL_ADMIN_PASSWORD=replace_with_strong_unique_admin_password
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_STUDENT_PASSWORD=replace_with_strong_unique_student_password

# AI Proctoring API Keys (Optional)
GEMINI_API_KEY=
GEMINI_VISION_MODEL=
DEEPSEEK_API_KEY=

# Client Application URLs
VITE_API_URL=/api
VITE_API_BASE_URL=/api

# Production requires PostgreSQL; leave empty ONLY for local JSON development.
DATABASE_URL=
DB_SSL=false
# Bind behind a local HTTPS reverse proxy in production.
HOST=127.0.0.1
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
ESKIZ_TOKEN=
ESKIZ_FROM=4546
SNAPSHOT_DIR=server/data/snapshots
SNAPSHOT_RETENTION_DAYS=30
# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_BOT_USERNAME=IbnsinoschoolBot
SITE_URL=https://ibnsinoschool.uz

# Optional path to public TLS certificate (never a private key).
TLS_CERT_PATH=

