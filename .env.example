# NextOlymp Environment Configuration
PORT=5000
NODE_ENV=development

# Server Security: Required in production (minimum 32 characters)
JWT_SECRET=replace_with_strong_random_secret_at_least_32_characters_long

# CORS Allowed Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Initial Admin & Seed Credentials (set your own strong passwords)
INITIAL_ADMIN_PASSWORD=Admin_Strong_Pass_2026!#
INITIAL_STUDENT_PASSWORD=Student_Demo_Pass_2026!#

# AI Proctoring API Keys (Optional)
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# Client Application URLs
VITE_API_URL=/api
VITE_API_BASE_URL=/api

